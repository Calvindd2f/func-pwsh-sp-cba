# =============================================================================
# func-pwsh-sp-cba — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
# These variables configure the Azure Functions PowerShell worker.
#
# Usage with Docker:
#   docker run --env-file .env -p 8080:80 pwsh-sp-cba
#
# Usage with Azure Functions Core Tools:
#   Copy values into local.settings.json under "Values"
# =============================================================================

# --- Required: Tenant & App Identity ---

# Your Entra ID (Azure AD) Tenant ID (GUID)
TENANT_ID=your-tenant-id

# The App Registration Client ID (GUID) — created by deploy/Create-EnterpriseApp.ps1
CLIENT_ID=your-client-id

# Your SharePoint Online root URL
# Examples: https://contoso.sharepoint.com, https://contoso-admin.sharepoint.com
SPO_URL=https://yourtenant.sharepoint.com

# --- Authentication (choose ONE method) ---

# Option 1: Certificate as Base64 PFX (RECOMMENDED for multi-tenant)
# Export your PFX and convert: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cert.pfx"))
CERTIFICATE_BASE64=

# Password for the PFX certificate (leave empty if no password)
CERTIFICATE_PASSWORD=

# Option 2: Certificate by thumbprint (single-tenant only, cert must be in local store)
CERTIFICATE_THUMBPRINT=

# Option 3: Client Secret (less secure, not recommended for production)
CLIENT_SECRET=

# --- Azure Functions Runtime (do not change unless you know what you're doing) ---
AzureWebJobsScriptRoot=/home/site/wwwroot
AzureFunctionsJobHost__Logging__Console__IsEnabled=true
